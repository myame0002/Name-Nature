{
  "expo": {
    "name": "NameNature",
    "slug": "Name-Nature",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon_home.png",
    "scheme": "namenature",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "namenature.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 28,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon_home.png",
        "backgroundColor": "#ffffff"
      },
      "package": "namenature.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      [
        "react-native-iap",
        {
          "storekitMode": "STOREKIT_HYBRID_MODE",
          "androidStore": "play"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8d8993ac-ed29-47f6-8618-a43d1d14eb56"
      }
    }
  }
}
